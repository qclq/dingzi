APP_NAME=dingzi-web-api
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+aiomysql://dingzi:dingzi@mysql:3306/dingzi
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost
# Optional one-time administrator bootstrap (never commit real values)
# INIT_ADMIN_USERNAME=
# INIT_ADMIN_PASSWORD=
# INIT_ADMIN_DISPLAY_NAME=
# INIT_ADMIN_EMAIL=
